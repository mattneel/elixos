#!/usr/bin/expect -f
# M15: agents are ordinary Elixos code. Jido is part of the OS itself
# (ADR-036) - a Jido agent is defined at the prompt and started under the
# system's own supervisor; one of its actions calls a model (a stub on the
# loopback here). Then the machine is saved, powered off, and powered on
# again: the next boot starts the agent with what it remembered.

set timeout 60

# Fail fast and loud. A timeout means the console is not where the script
# thinks it is; continuing only desynchronizes the rest of the demo and burns
# another timeout. (The shim sets TERM=linux, so IEx colours its output -
# colour escapes sit inside the very strings a pattern waits for, which is why
# the demo turns them off with IEx.configure before doing anything else.)
expect_after {
    timeout {
        puts stderr "\nDEMO ABORTED waiting for a pattern. Last output:\n$expect_out(buffer)"
        exit 1
    }
}
set send_human {.1 .3 10 .05 2}

spawn -noecho qemu-system-x86_64 \
    -machine q35 -accel kvm -accel tcg -cpu max -m 1024 -smp 2 \
    -nographic -no-reboot \
    -kernel $env(ELIXOS_DEMO_KERNEL) -initrd $env(ELIXOS_DEMO_INITRAMFS) \
    -append "console=ttyS0 panic=-1 quiet elixos.commit_after=3600" \
    -drive "file=$env(ELIXOS_DEMO_DISK),if=virtio,format=raw" \
    -device virtio-rng-pci -nic none
set qemu $spawn_id

expect "iex(1)> "
sleep 1

# A recording is easier to read - and to drive - without colour: the escapes
# land inside the very strings the script waits for.
send {IEx.configure(colors: [enabled: false])}
send "\r"
expect -re {iex\([0-9]+\)> }
sleep 1

# Jido is a dependency of Elixos itself (ADR-036): it is already running
# before this prompt exists. Nothing to add, nothing to install.
send {Application.spec(:jido, :vsn)}
send "\r"
expect {~c"2.4.0"}
sleep 1

# An agent is a module, and a prompt defines it - one expression, the way a
# defmodule is typed.
send {(defmodule Demo.Jido do
  use Jido, otp_app: :demo_agents
end

defmodule Demo.Note do
  use Jido.Action, name: "note", schema: [note: [type: :string, default: ""]]
  def run(params, _ctx), do: {:ok, %{last: params.note}}
end

defmodule Demo.Ask do
  use Jido.Action, name: "ask", schema: [prompt: [type: :string, default: "hello"]]
  def run(params, _ctx) do
    case Elixos.Agents.LLM.complete([{"user", params.prompt}], base_url: "http://127.0.0.1:4040/v1", model: "stub-model") do
      {:ok, text} -> {:ok, %{answer: text}}
      {:error, reason} -> {:error, reason}
    end
  end
end

defmodule Demo.Agent do
  use Jido.Agent, name: "demo_agent",
    schema: [last: [type: :string, default: ""], answer: [type: :string, default: ""]],
    signal_routes: [{"note", Demo.Note}, {"ask", Demo.Ask}]
end

defmodule Demo.Stub do
  def start(port, text) do
    {:ok, listen} = :gen_tcp.listen(port, [:binary, active: false, reuseaddr: true])
    spawn_link(fn -> loop(listen, text) end)
    :ok
  end
  defp loop(listen, text) do
    {:ok, socket} = :gen_tcp.accept(listen)
    :gen_tcp.recv(socket, 0, 5000)
    body = IO.iodata_to_binary(:json.encode(%{"choices" => [%{"message" => %{"content" => text}}]}))
    :gen_tcp.send(socket, ["HTTP/1.1 200 OK\r\ncontent-type: application/json\r\ncontent-length: ", Integer.to_string(byte_size(body)), "\r\nconnection: close\r\n\r\n", body])
    :gen_tcp.close(socket)
    loop(listen, text)
  end
end

defmodule Demo do
  def ask(id, type, data) do
    {:ok, _agent} = Jido.AgentServer.call(Elixos.Agents.whereis(id), Jido.Signal.new!(type, data))
    state(id)
  end
  def state(id) do
    {:ok, state} = Jido.AgentServer.state(Elixos.Agents.whereis(id))
    state.agent.state
  end
end

:ok)}
send "\r"
expect -re {iex\([0-9]+\)> }
sleep 2

send "Elixos.Agents.start(Demo.Agent, id: \"greeter\", jido: Demo.Jido)\r"
expect "{:ok, #PID<"
sleep 1
send "Demo.ask(\"greeter\", \"note\", %{note: \"remember me\"})\r"
expect {last: "remember me"}
sleep 1

# An action that asks a model - the stub answers over the loopback.
send "Demo.Stub.start(4040, \"a model said hello\")\r"
expect -re {iex\([0-9]+\)> }
sleep 1
send "Elixos.Agents.start(Demo.Agent, id: \"scribe\", jido: Demo.Jido)\r"
expect "{:ok, #PID<"
sleep 1
send "Demo.ask(\"scribe\", \"ask\", %{prompt: \"say hello\"})\r"
expect {answer: "a model said hello"}
sleep 2

send "Elixos.Agents.list() |> Map.keys() |> Enum.sort()\r"
expect -exact {["greeter", "scribe"]}
sleep 1

# The live image saves what was typed and what the agents remember; then the
# machine goes dark.
send "Elixos.save()\r"
expect {:ok, 1}
sleep 2
send "Elixos.poweroff()\r"
expect "elixos-shim: shutdown poweroff"
expect "reboot: Power down"
expect eof
sleep 2

# Power on again: the same disk, the same modules, both agents running, the
# note still there.
spawn -noecho qemu-system-x86_64 \
    -machine q35 -accel kvm -accel tcg -cpu max -m 1024 -smp 2 \
    -nographic -no-reboot \
    -kernel $env(ELIXOS_DEMO_KERNEL) -initrd $env(ELIXOS_DEMO_INITRAMFS) \
    -append "console=ttyS0 panic=-1 quiet elixos.commit_after=3600" \
    -drive "file=$env(ELIXOS_DEMO_DISK),if=virtio,format=raw" \
    -device virtio-rng-pci -nic none
set second $spawn_id

expect "iex(1)> "
sleep 1
# A fresh IEx: the first boot's colours-off was session state, not saved.
send {IEx.configure(colors: [enabled: false])}
send "\r"
expect -re {iex\([0-9]+\)> }
sleep 1
send "Elixos.Agents.list() |> Map.keys() |> Enum.sort()\r"
expect -exact {["greeter", "scribe"]}
sleep 1
send "Demo.state(\"greeter\")\r"
expect {last: "remember me"}
sleep 2

send "Elixos.poweroff()\r"
expect "elixos-shim: shutdown poweroff"
expect eof
sleep 1
