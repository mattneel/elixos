[2.000, "o", "(defmodule Demo.Jido do\r\r\r\n  use Jido, otp_app: :demo_agents\r\r\r\nend\r\r\r\n\r\r\r\ndefmodule Demo.Note do\r\r\r\n  use Jido.Action, name: \"note\", schema: [note: [type: :string, default: \"\"]]\r\r\r\n  def run(params, _ctx), do: {:ok, %{last: params.note}}\r\r\r\nend\r\r\r\n\r\r\r\ndefmodule Demo.Ask do\r\r\r\n  use Jido.Action, name: \"ask\", schema: [prompt: [type: :string, default: \"hello\"]]\r\r\r\n  def run(params, _ctx) do\r\r\r\n    case Elixos.Agents.LLM.complete([{\"user\", params.prompt}], base_url: \"http://127.0.0.1:4040/v1\", model: \"stub-model\") do\r\r\r\n      {:ok, text} -> {:ok, %{answer: text}}\r\r\r\n      {:error, reason} -> {:error, reason}\r\r\r\n    end\r\r\r\n  end\r\r\r\nend\r\r\r\n\r\r\r\ndefmodule Demo.Agent do\r\r\r\n  use Jido.Agent, name: \"demo_agent\",\r\r\r\n    schema: [last: [type: :string, default: \"\"], answer: [type: :string, default: \"\"]],\r\r\r\n    signal_routes: [{\"note\", Demo.Note}, {\"ask\", Demo.Ask}]\r\r\r\nend\r\r\r\n\r\r\r\ndefmodule Demo.Stub do\r\r\r\n  def start(port, text) do\r\r\r\n    {:ok, listen} = :gen_tcp.listen(port, [:binary, active: false, reuseaddr: true])\r\r\r\n    spawn_link(fn -> loop(listen, text) end)\r\r\r\n    :ok\r\r\r\n  end\r\r\r\n  defp loop(listen, text) do\r\r\r\n    {:ok, socket} = :gen_tcp.accept(listen)\r\r\r\n    :gen_tcp.recv(socket, 0, 5000)\r\r\r\n    body = IO.iodata_to_binary(:json.encode(%{\"choices\" => [%{\"message\" => %{\"content\" => text}}]}))\r\r\r\n    :gen_tcp.send(socket, [\"HTTP/1.1 200 OK\\r\\ncontent-type: application/json\\r\\ncontent-length: \", Integer.to_string(byte_size(body)), \"\\r\\nconnection: close\\r\\n\\r\\n\", body])\r\r\r\n    :gen_tcp.close(socket)\r\r\r\n    loop(listen, text)\r\r\r\n  end\r\r\r\nend\r\r\r\n\r\r\r\ndefmodule Demo do\r\r\r\n  def ask(id, type, data) do\r\r\r\n    {:ok, _agent} = Jido.AgentServer.call(Elixos.Agents.whereis(id), Jido.Signal.new!(type, data))\r\r\r\n    state(id)\r\r\r\n  end\r\r\r\n  def state(id) do\r\r\r\n    {:ok, state} = Jido.AgentServer.state(Elixos.Agents.whereis(id))\r\r\r\n    state.agent.state\r\r\r\n  end\r\r\r\nend\r\r\r\n\r\r\r\n:ok)\r\r\r\niex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> iex(3)> :ok\r\r\r\niex(4)> "]
