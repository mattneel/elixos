# Elixos kernel config fragment (x86_64 only, ADR-014).
#
# Applied on top of `x86_64_defconfig` + `kvm_guest.config` by scripts/build-kernel.sh,
# then checked by scripts/check-kernel-config.sh: every line below must survive
# `make olddefconfig` verbatim, or the build fails. That check is the kernel's test.
#
# Rule: Elixos has no modprobe and no udev, so anything we need is built in (=y).

# --- early userspace: initramfs with the Zig shim as /init ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y

# --- syscalls the shim depends on (ADR-002) ---
CONFIG_SIGNALFD=y
CONFIG_EPOLL=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_FUTEX=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# --- the system database: Postgres wants SysV IPC even when its shared memory
# uses mmap - it always creates a small System V segment as a lock (M16).
# x86_64_defconfig enables it; naming it here is what makes the guard keep it.
CONFIG_SYSVIPC=y

# --- UEFI: the firmware boots the kernel directly via the EFI stub (ADR-014) ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y

# --- QEMU devices used by the test harness ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_WATCHDOG=y
CONFIG_I6300ESB_WDT=y

# --- storage: the persistent image lives on ext4; the ESP is FAT ---
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# --- consoles: serial for QEMU, framebuffer for the cyberdeck's own screen ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# --- networking: kernel IP autoconfig (ip=dhcp) until Elixos has its own client ---
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y

# --- consoles: keep the log out of the shim's way ---
# The shim's console lines are API, matched byte for byte by the QEMU tests
# (docs/PROTOCOL.md §6). DEBUG_STACK_USAGE prints "used greatest stack depth"
# with pr_info() when a task exits, which interleaves with those lines on the
# serial console; it is a debug option with nothing to offer a cyberdeck.
# CONFIG_DEBUG_STACK_USAGE is not set

# --- guest niceties ---
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
