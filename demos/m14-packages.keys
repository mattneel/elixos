# What the M14 demo must show, in order: the official repository is trusted
# out of the box, adding one with its key is the consent step, a name is
# found among the trusted repositories and installed by name.
elixos-shim: pid 1, version
iex(1)> Enum.map(Elixos.Package.repos(), & &1.name)
[:elixos]
iex(2)> Elixos.Package.add_repo(:fixture, "/priv/hex-repo", key: File.read!("/priv/hex-repo/public_key"))
:ok
iex(3)> Elixos.Package.search("hello")
[{"hello_pkg", ["0.1.0"]}]
iex(4)> Elixos.Package.info("hello_pkg")
[installed: false, version: "0.1.0"]
iex(5)> Elixos.Package.install(:hello_pkg)
{:ok, :hello_pkg}
iex(6)> HelloPkg.greet()
:hello_from_hex
elixos-shim: shutdown poweroff
