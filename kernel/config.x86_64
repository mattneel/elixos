# Elixos kernel config: x86_64 (ADR-041).
#
# Applied over x86_64_defconfig + kvm_guest.config, on top of the common
# fragment (kernel/elixos.config); the guard checks all three files together.
# Everything here is a symbol arm64 does not have (or spells differently).

# --- guest niceties, x86 only: the KVM guest bits are x86 symbols ---
CONFIG_HYPERVISOR_GUEST=y
CONFIG_KVM_GUEST=y

# --- the serial console: x86 QEMU's 8250 UART on ttyS0 ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- QEMU's -watchdog device is the i6300esb, an x86 PCI part ---
CONFIG_I6300ESB_WDT=y
