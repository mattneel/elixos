#!/usr/bin/expect -f
# M25: a browser to call from the prompt. It is in the read-only system image
# (nothing is downloaded on the box), it comes up with the system, and the verbs
# work: navigate, evaluate, screenshot - over the ecosystem's stack, with the
# process spawned as a Port.
#
# No page is served here on purpose: Lightpanda renders its own "navigation
# failed" page for a refused connection, which is a real render to read, and the
# QEMU acceptance covers the stub-server path (m25_browser_test.exs).
set timeout 300
expect_after {
    timeout {
        puts stderr "\nDEMO ABORTED waiting for a pattern. Last output:\n$expect_out(buffer)"
        exit 1
    }
}

proc boot {} {
    global env spawn_id
    spawn -noecho qemu-system-x86_64 \
        -machine q35 -accel kvm -accel tcg -cpu max -m 1024 -smp 2 \
        -nographic -no-reboot \
        -kernel $env(ELIXOS_DEMO_KERNEL) -initrd $env(ELIXOS_DEMO_INITRAMFS) \
        -append "console=ttyS0 panic=-1 quiet elixos.commit_after=3600" \
        -drive "file=$env(ELIXOS_DEMO_DISK),if=virtio,format=raw" \
        -device virtio-rng-pci -nic none
    expect "iex(1)> "
    send {IEx.configure(colors: [enabled: false])}
    send "\r"
    expect -re {iex\([0-9]+\)> }
    sleep 1
}

boot

# The adapter is running.
send {Elixos.Browser.status()}
send "\r"
expect -re {[\r\n]+\{:ok, #PID<[0-9]+\.[0-9]+\.[0-9]+>\}[\r\n]+}
expect -re {iex\([0-9]+\)> }
sleep 1

# And its argv came from the image: a loader first, for the glibc binary the
# manifest names (ADR-064).
send {Elixos.Browser.command()}
send "\r"
expect -re {[\r\n]+\{:ok,}
expect -re {/system/browser/glibc/ld-linux-x86-64\.so\.2}
expect -re {iex\([0-9]+\)> }
sleep 1

# "Shipped, never downloaded": it lives on the read-only image.
send {File.read!("/proc/mounts") |> String.split("\n") |> Enum.find(&String.contains?(&1, " /system "))}
send "\r"
# The echoed command also says /system, so pace on the filesystem's own words.
expect -re {squashfs ro}
expect -re {iex\([0-9]+\)> }
sleep 1

# Navigate, and read the page's text back. A data: URL is a page Lightpanda
# renders itself, so the demo needs no server (the QEMU acceptance covers a
# stub server on the loopback).
send {Elixos.Browser.navigate("data:text/html,<title>demo</title><h1>hello from a data url</h1>")}
send "\r"
expect -re {[\r\n]+\{:ok, "hello from a data url"\}[\r\n]+}
expect -re {iex\([0-9]+\)> }
sleep 1

# Evaluate: JavaScript in that page - its title, and arithmetic.
send {Elixos.Browser.eval("document.title")}
send "\r"
expect -re {[\r\n]+\{:ok, "demo"\}[\r\n]+}
expect -re {iex\([0-9]+\)> }
sleep 1

# Screenshot: a PNG of what it rendered.
send {with {:ok, png} <- Elixos.Browser.screenshot(), do: {byte_size(png), binary_part(png, 0, 4)}}
send "\r"
expect -re {[\r\n]+\{\d+, <<137, 80, 78, 71>>\}[\r\n]+}
expect -re {iex\([0-9]+\)> }
sleep 1

send {Elixos.poweroff()}
send "\r"
expect "elixos-shim: shutdown poweroff"
expect eof
