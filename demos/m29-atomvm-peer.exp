#!/usr/bin/expect -f
# M29: an AtomVM node is Elixos's peer. Elixos in QEMU has a second,
# restricted NIC - the coprocessor link (elixos.coproc_link) - and the only
# thing at its far end is AtomVM's Unix build on the host, running the
# coprocessor runtime. IEx configures the link, the host AtomVM starts with the
# cookie from /priv, and a module typed at the prompt becomes the
# coprocessor's code by saving a generation: deployed, AtomVM restarted, and
# called from IEx. Both terminals are in this recording.

set timeout 300
set send_human {.1 .3 10 .05 2}
set root [file normalize [file dirname [info script]]/..]
set port [expr {20000 + int(rand() * 20000)}]
set dir /tmp/elixos-m29-demo
catch {exec rm -rf $dir}
exec mkdir -p $dir

# The coprocessor runtime archive, packed from the OS's own compiled code.
exec sh -c "cd $root/os && mix run --no-start -e 'File.write!(\"$dir/runtime.avm\", elem(Elixos.Coproc.runtime(), 1))'"

spawn -noecho qemu-system-x86_64 \
    -machine q35 -accel kvm -accel tcg -cpu max -m 1024 -smp 2 \
    -nographic -no-reboot \
    -kernel $env(ELIXOS_DEMO_KERNEL) -initrd $env(ELIXOS_DEMO_INITRAMFS) \
    -append "console=ttyS0 panic=-1 quiet elixos.commit_after=3600 ip=:::::eth0:dhcp elixos.coproc_link=eth1,10.0.3.15/24" \
    -drive "file=$env(ELIXOS_DEMO_DISK),if=virtio,format=raw" \
    -netdev user,id=n0 -device virtio-net-pci,netdev=n0 \
    -netdev "user,id=n1,net=10.0.3.0/24,restrict=on,guestfwd=tcp:10.0.3.9:4370-cmd:socat - TCP:127.0.0.1:$port" \
    -device virtio-net-pci,netdev=n1
set qemu $spawn_id

expect "iex(1)> "
sleep 1
send "Elixos.Coproc.configure(node: :\"coproc@10.0.3.9\", port: 4370)\r"
expect -re {"([0-9a-f]{48})"}
set cookie $expect_out(1,string)
expect "iex(2)> "
sleep 1

# The coprocessor, on the host: the runtime and AtomVM's library, restarted
# whenever it exits - as a deploy makes it do.
exec sh -c "printf '%s\\n' $cookie > $dir/cookie"
spawn -noecho sh -c "while true; do \
    ELIXOS_COPROC_NODE=coproc@10.0.3.9 ELIXOS_COPROC_PORT=$port \
    ELIXOS_COPROC_COOKIE_FILE=$dir/cookie ELIXOS_COPROC_BUNDLE=$dir/bundle.avm \
    $root/build/atomvm/AtomVM $dir/runtime.avm $root/build/atomvm/atomvmlib.avm; sleep 1; done"
set atomvm $spawn_id
expect "up, bundle none"

set spawn_id $qemu
send "Enum.find_value(1..100, fn _ -> Process.sleep(100); Node.list() != \[\] && Node.list() end)\r"
expect "iex(3)> "
sleep 1
send "defmodule Greeter do\r"
send "  def hello(name), do: \"hello #{name}, from #{node()}\"\r"
send "end\r"
expect "iex(4)> "
sleep 1
send "Elixos.Coproc.put_bundle(\[Greeter\])\r"
expect "iex(5)> "
sleep 1
send "Elixos.save()\r"
expect "iex(6)> "

set spawn_id $atomvm
expect -re {bundle [0-9a-f]{64} deployed}
expect -re {up, bundle [0-9a-f]{64}}

set spawn_id $qemu
sleep 1
send "Elixos.Coproc.call(Greeter, :hello, \[\"elixos\"\])\r"
expect "iex(7)> "
sleep 1
send "pid = Node.spawn(:\"coproc@10.0.3.9\", :timer, :sleep, \[500\]); ref = Process.monitor(pid)\r"
expect "iex(8)> "
send "receive do {:DOWN, ^ref, :process, ^pid, reason} -> {node(pid), reason} end\r"
expect "iex(9)> "
sleep 1

send "Elixos.poweroff()\r"
expect "elixos-shim: shutdown poweroff"
expect "reboot: Power down"
expect eof
sleep 1

set spawn_id $atomvm
exec kill [exp_pid -i $atomvm]
catch {exec pkill -f $dir/runtime.avm}
