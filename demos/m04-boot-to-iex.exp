#!/usr/bin/expect -f
# M4: boot to IEx. The kernel runs the shim, the shim runs the BEAM with the
# control pipe, and the console lands at iex(1)> — then Elixos.poweroff() asks
# the shim to power the machine off (docs/ROADMAP.md M4).
#
# Here the boot is not the point, so the kernel log is quieted. Every wait is
# for real output: a prompt, or a shim line.

set timeout 180
set send_human {.1 .3 10 .05 2}

spawn -noecho qemu-system-x86_64 \
    -machine q35 -accel kvm -accel tcg -cpu max -m 1024 -smp 2 \
    -nographic -no-reboot \
    -kernel $env(ELIXOS_DEMO_KERNEL) -initrd $env(ELIXOS_DEMO_INITRAMFS) \
    -append "console=ttyS0 panic=-1 quiet" \
    -drive "file=$env(ELIXOS_DEMO_DISK),if=virtio,format=raw" \
    -device virtio-rng-pci -nic none

expect "iex(1)> "
sleep 1

send -h "1 + 1\r"
expect "iex(2)> "
sleep 1

send -h "Elixos.info()\r"
expect "iex(3)> "
sleep 2

send -h "Elixos.poweroff()\r"
expect "elixos-shim: shutdown poweroff"
expect "reboot: Power down"
expect eof
