#!/usr/bin/expect -f
# M27: Oh-My-Jido approvals on the packaged framebuffer with a real evdev
# keyboard (ADR-093). The machine boots to IEx; the GUI opens only on request
# and hands the screen back once nothing is pending.
set timeout 300
set qmp "/tmp/exdemo-[pid].sock"
set frames "$env(ELIXOS_DEMO_FRAMES)"
set helper ""
set vm ""
proc cleanup {} {
    global helper vm qmp
    if {$helper ne ""} {
        catch {exec kill -KILL [exp_pid -i $helper]}
        catch {close -i $helper}
        catch {wait -i $helper}
    }
    if {$vm ne ""} {
        catch {exec kill -KILL [exp_pid -i $vm]}
        catch {close -i $vm}
        catch {wait -i $vm}
    }
    catch {file delete $qmp}
}
expect_after {
    timeout { puts stderr "DEMO ABORTED: $expect_out(buffer)"; cleanup; exit 1 }
}
trap {cleanup; exit 1} {SIGINT SIGTERM}
spawn -noecho qemu-system-x86_64 \
    -machine q35 -accel kvm -accel tcg -cpu max -m 1024 -smp 2 \
    -display none -monitor none -serial stdio -no-reboot \
    -vga none -device virtio-gpu-pci -device virtio-keyboard-pci \
    -qmp "unix:$qmp,server=on,wait=off" \
    -kernel $env(ELIXOS_DEMO_KERNEL) -initrd $env(ELIXOS_DEMO_INITRAMFS) \
    -append "console=ttyS0 panic=-1 quiet elixos.commit_after=3600" \
    -drive "file=$env(ELIXOS_DEMO_DISK),if=virtio,format=raw" \
    -device virtio-rng-pci -nic none
set vm $spawn_id
expect "iex(1)> "
proc command {expression} {
    global spawn_id vm
    set spawn_id $vm
    send -- "$expression\r"
    # Wait for the echoed line first, then its completed next prompt.
    expect -exact $expression
    expect -re {iex\([0-9]+\)> }
}
command {IEx.configure(colors: [enabled: false])}
spawn -noecho elixir demos/gui-capture.exs $qmp $frames
set helper $spawn_id
expect "CAPTURE READY"
set spawn_id $vm
command {IO.puts("M27 GUI " <> inspect(Elixos.GUI.status()) <> " " <> inspect(Elixos.GUI.start()))}
command {{:ok, session} = OhMyJido.start_session(Elixos.Approvals.runtime(), workspace: "/priv/home", tools: [OhMyJido.Tools.Question], permissions: [:ask, :exec])}
proc key {qcode} {
    global spawn_id helper vm
    set spawn_id $helper
    send -- "KEY $qcode\r"
    expect -exact "KEY SENT $qcode"
    sleep 0.2
    set spawn_id $vm
}
proc question {name ask expected keys} {
    global spawn_id vm
    command "spawn(fn -> File.write!(\"/priv/m27-$name.answer\", inspect($ask)) end)"
    # The waiting tool registers its request asynchronously; wait for it.
    command {IO.puts("M27 PENDING " <> inspect(Enum.reduce_while(1..80, [], fn _, _ -> case Elixos.Approvals.pending() do [] -> Process.sleep(250); {:cont, []}; requests -> {:halt, Enum.map(requests, & &1.kind)} end end)))}
    command {IO.puts("M27 OPEN " <> inspect(Elixos.GUI.start()))}
    sleep 2
    foreach qcode $keys { key $qcode }
    # Wait on the real waiting tool's result, never on a synthetic GUI answer.
    set spawn_id $vm
    set expr "Enum.reduce_while(1..120, nil, fn _, _ -> if File.exists?(\"/priv/m27-$name.answer\"), do: {:halt, File.read!(\"/priv/m27-$name.answer\")}, else: (Process.sleep(250); {:cont, nil}) end) |> then(fn answer -> IO.puts(\"M27 ANSWER $name \" <> to_string(answer)) end)"
    send -- "$expr\r"
    expect -exact "\nM27 ANSWER $name $expected"
    expect -re {iex\([0-9]+\)> }
    sleep 2
    command {IO.puts("M27 HANDED BACK " <> inspect(Elixos.GUI.status()))}
}
question approve {({:ok, context} = OhMyJido.Session.call(session, :context); OhMyJido.Tool.authorize(context, :exec, %{sensitive: true, operation: "boot the cyberdeck"}))} {:ok} {y}
question text {OhMyJido.execute_tool(session, "question", %{question: "Name this machine"})} {{:ok, %{answer: "hello"}}} {h e l l o ret}
question choice {OhMyJido.execute_tool(session, "question", %{question: "Choose a color", options: [%{label: "Blue"}, %{label: "Green"}]})} {{:ok, %{answer: %{label: "Green"}}}} {down ret}
question multi {OhMyJido.execute_tool(session, "question", %{question: "Enable services", options: [%{label: "Network"}, %{label: "Audio"}], multi: true})} {{:ok, %{answer: [%{label: "Network"}, %{label: "Audio"}]}}} {spc down spc ret}
command {IO.puts("M27 STOP " <> inspect(Elixos.GUI.stop()))}
sleep 2
command {IO.puts("M27 CONSOLE " <> inspect(40 + 2))}
command {IO.puts("M27 FBCON " <> inspect(Path.wildcard("/sys/class/vtconsole/vtcon*/name") |> Enum.filter(fn p -> String.contains?(File.read!(p), "frame buffer") end) |> Enum.map(fn p -> File.read!(Path.join(Path.dirname(p), "bind")) |> String.trim() end)))}
sleep 2
set spawn_id $helper
send -- "STOP\r"
expect -re {CAPTURE STOPPED [0-9]+}
expect eof
catch {wait -i $helper}
set helper ""
set spawn_id $vm
send {Elixos.poweroff()}
send "\r"
expect "elixos-shim: shutdown poweroff"
expect eof
catch {wait -i $vm}
set vm ""
cleanup
