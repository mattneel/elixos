# Elixos kernel config: riscv64 (M28).
#
# Applied over riscv's defconfig, on top of the common fragment
# (kernel/elixos.config); the guard checks both files together.
# This is configuration only: the kernel stays unmodified mainline (ADR-001).

# --- QEMU virt: the platform M28's tests boot ---
CONFIG_ARCH_VIRT=y
CONFIG_RISCV_SBI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_MMIO=y
CONFIG_RTC_DRV_GOLDFISH=y

# --- the serial console: virt's ns16550a at 0x10000000 is ttyS0 ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y

# --- poweroff and reboot through virt's syscon (SBI SRST also works) ---
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y

# --- the LilyGO T-Display K230 (M30, ADR-101) ---
# The big core: Svpbmt (not T-Head MAE; the errata only match marchid 0),
# RVV 1.0 and Zicbom for the dma-noncoherent SoC bus. From riscv's defconfig,
# named here so the guard keeps them.
CONFIG_ARCH_CANAAN=y
CONFIG_RISCV_ISA_SVPBMT=y
CONFIG_RISCV_ISA_V=y
CONFIG_RISCV_ISA_ZICBOM=y
# The SoC drivers the board device tree binds. The clock and pinctrl drivers
# have no default: without the clock driver UART0 has no clock and there is
# no console.
CONFIG_COMMON_CLK_K230=y
CONFIG_PINCTRL_K230=y
CONFIG_RESET_K230=y
CONFIG_SERIAL_8250_DW=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
CONFIG_PHY_CANAAN_USB=y
# The shared regions with the little core, as /dev/uioN (M31, ADR-112).
CONFIG_UIO=y
CONFIG_UIO_PDRV_GENIRQ=y
